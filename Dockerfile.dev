FROM node:20-alpine

WORKDIR /app

# Install dependencies first for optimal layer caching
COPY package*.json ./
# The dev server doesn't need the Electron runtime (Steam build only)
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm install

# Copy all source files
COPY . .

EXPOSE 5173

# Ensure hot module reloading works across container boundary
ENV CHOKIDAR_USEPOLLING=true

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
